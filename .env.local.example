# Copie ce fichier en .env.local et remplis les valeurs.
# Tu les trouves dans Supabase : Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site, sans slash final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verrou d'acces pendant la phase de test.
# Renseigne cette variable UNIQUEMENT sur Vercel, pas en local :
# tant qu'elle est vide, le site s'ouvre sans mot de passe.
# La retirer sur Vercel ouvre le site au public.
SITE_PASSWORD=

# Coupe-circuit des images.
# Les visuels des marques passent par /api/img : un seul domaine, du WebP
# à la bonne taille, un cache d'un an. La route redirige vers l'adresse
# d'origine au moindre imprévu, donc elle ne peut pas casser un visuel.
# Mettre 1 ici remet malgré tout tout le monde en direct, sans toucher au
# code, si jamais elle posait problème en production.
# NEXT_PUBLIC_IMAGES_DIRECTES=1
