# Copie ce fichier en .env.local et remplis les valeurs.
# Tu les trouves dans Supabase : Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site, sans slash final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verrou d'acces pendant la phase de test.
# Renseigne cette variable UNIQUEMENT sur Vercel, pas en local :
# tant qu'elle est vide, le site s'ouvre sans mot de passe.
# La retirer sur Vercel ouvre le site au public.
SITE_PASSWORD=
